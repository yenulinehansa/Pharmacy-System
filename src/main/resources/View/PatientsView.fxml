<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="532.0" prefWidth="1188.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.PatientViewController">
    <children>
        <Label layoutX="35.0" layoutY="44.0" text="Patient Details">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TableView fx:id="tblPatients" layoutX="35.0" layoutY="90.0" prefHeight="384.0" prefWidth="495.0">
            <columns>
                <TableColumn fx:id="colid" prefWidth="152.80002212524414" text="ID" />
                <TableColumn fx:id="colName" prefWidth="175.9999542236328" text="NAME" />
                <TableColumn fx:id="colTelNo" prefWidth="166.39996337890625" text="TELNO" />
            </columns>
        </TableView>
        <TextField fx:id="txtid" layoutX="666.0" layoutY="131.0" prefHeight="26.0" prefWidth="354.0" />
        <TextField fx:id="txtname" layoutX="666.0" layoutY="195.0" prefHeight="26.0" prefWidth="354.0" />
        <TextField fx:id="txtTelNo" layoutX="666.0" layoutY="255.0" prefHeight="26.0" prefWidth="354.0" />
        <Label layoutX="571.0" layoutY="133.0" text="ID :">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Label>
        <Label layoutX="571.0" layoutY="197.0" text="Name :">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Label>
        <Label layoutX="571.0" layoutY="257.0" text="TelNo :">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Label>
        <Button fx:id="btnupdate" layoutX="710.0" layoutY="348.0" mnemonicParsing="false" onAction="#onupdate" prefHeight="46.0" prefWidth="87.0" style="-fx-background-color: rgba(65, 201, 44, 1);" text="Update">
            <font>
                <Font size="17.0" />
            </font>
        </Button>
        <Button fx:id="btndelete" layoutX="856.0" layoutY="348.0" mnemonicParsing="false" onAction="#ondelete" prefHeight="46.0" prefWidth="87.0" style="-fx-background-color: rgba(201, 44, 44, 1);" text="Delete">
            <font>
                <Font size="17.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
