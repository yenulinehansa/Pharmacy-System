<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="532.0" prefWidth="1188.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.AdminSupplierAddingController">

    <children>
        <Label layoutX="28.0" layoutY="35.0" text="Supplier List">
            <font>
                <Font name="Roboto Medium" size="16.0" />
            </font>
        </Label>

        <TableView fx:id="tblSuppliers" layoutX="28.0" layoutY="127.0" prefHeight="342.0" prefWidth="650.0"
                   style="-fx-background-color: rgba(178, 182, 188, 1);">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="Id" />
                <TableColumn fx:id="colName" prefWidth="135.20001220703125" text="Name" />
                <TableColumn fx:id="colTelNo" prefWidth="92.79998779296875" text="Tel No" />
                <TableColumn fx:id="colEmail" prefWidth="152.79998779296875" text="Email" />
                <TableColumn fx:id="colCompany" prefWidth="88.79998779296875" text="Company" />
                <TableColumn fx:id="colRegDate" prefWidth="110.40008544921875" text="Reg Date" />
            </columns>
        </TableView>

        <Label layoutX="800.0" layoutY="54.0" text="Supplier Management">
            <font>
                <Font name="Microsoft PhagsPa Bold" size="16.0" />
            </font>
        </Label>

        <Label layoutX="741.0" layoutY="118.0" text="ID :">
            <font>
                <Font name="Calibri Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="741.0" layoutY="168.0" prefHeight="22.0" prefWidth="66.0" text="Name :">
            <font>
                <Font name="Calibri Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="741.0" layoutY="223.0" prefHeight="22.0" prefWidth="66.0" text="Tel No :">
            <font>
                <Font name="Calibri Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="741.0" layoutY="283.0" prefHeight="22.0" prefWidth="94.0" text="Email">
            <font>
                <Font name="Calibri Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="741.0" layoutY="345.0" prefHeight="22.0" prefWidth="94.0" text="Company">
            <font>
                <Font name="Calibri Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="741.0" layoutY="400.0" prefHeight="22.0" prefWidth="94.0" text="Reg Date :">
            <font>
                <Font name="Calibri Bold" size="18.0" />
            </font>
        </Label>

        <TextField fx:id="txtId" layoutX="850.0" layoutY="116.0" onAction="#OnIdSelected" prefWidth="270.0" />
        <TextField fx:id="txtSearch" layoutX="28.0" layoutY="64.0" onAction="#OnSearch" prefHeight="26.0" prefWidth="391.0" promptText="Search" />
        <TextField fx:id="txtName" layoutX="850.0" layoutY="166.0" prefWidth="270.0" />
        <TextField fx:id="txtTelNo" layoutX="850.0" layoutY="221.0" prefWidth="270.0" />
        <TextField fx:id="txtEmail" layoutX="850.0" layoutY="281.0" prefWidth="270.0" />
        <TextField fx:id="txtCompany" layoutX="850.0" layoutY="343.0" prefWidth="270.0" />

        <Button fx:id="btnAdd" layoutX="750.0" layoutY="450.0" mnemonicParsing="false" onAction="#OnAdd"
                prefHeight="43.0" prefWidth="112.0" style="-fx-background-color: rgba(86, 208, 52, 1);" text="Add">
            <font>
                <Font name="System Bold" size="21.0" />
            </font>
        </Button>

        <Button fx:id="btnUpdate" layoutX="880.0" layoutY="450.0" mnemonicParsing="false" onAction="#OnUpdate"
                prefHeight="43.0" prefWidth="112.0" style="-fx-background-color: rgba(208, 143, 52, 1);" text="Update">
            <font>
                <Font name="System Bold" size="21.0" />
            </font>
        </Button>

        <Button fx:id="btnDelete" layoutX="1010.0" layoutY="450.0" mnemonicParsing="false" onAction="#OnDelete"
                prefHeight="43.0" prefWidth="112.0" style="-fx-background-color: rgba(226, 38, 38, 1);" text="Delete">
            <font>
                <Font name="System Bold" size="21.0" />
            </font>
        </Button>

        <DatePicker fx:id="datePicker" layoutX="850.0" layoutY="398.0" prefHeight="26.0" prefWidth="270.0" />

        <Button fx:id="btnView" layoutX="28.0" layoutY="489.0" mnemonicParsing="false" onAction="#Onview"
                prefHeight="43.0" prefWidth="94.0" style="-fx-background-color: rgba(201, 44, 138, 1);" text="View">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Button>
    </children>
</AnchorPane>